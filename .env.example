
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096
LLM_MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=120

GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

DATABASE_URL=sqlite:///./data/agentic_review.db

