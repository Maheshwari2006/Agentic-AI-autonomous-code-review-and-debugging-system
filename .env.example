# ---------------------------------------------------------------------------
# Agentic AI Code Review & Debugging System -- environment configuration
#
# Copy this file to `.env` and fill in real values. Never commit `.env`
# itself (it's already in .gitignore).
# ---------------------------------------------------------------------------

# --- Anthropic (required for real AI review/debugging/fix generation) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model string -- change without touching source code. See README for
# current recommended models.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096
LLM_MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=120

# --- GitHub ---
# Personal access token (classic or fine-grained) with `repo` read access.
# https://github.com/settings/tokens
# Public repos work without a token too, but you're limited to 60
# unauthenticated requests/hour instead of 5000/hour.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# --- Database ---
# SQLite for the prototype. To use PostgreSQL instead, install
# `psycopg[binary]` and point this at a postgresql+psycopg:// DSN --
# no code changes required (see backend/app/database/models.py).
DATABASE_URL=sqlite:///./data/agentic_review.db

# --- Retrieval / agent-loop safety bounds ---
# NOT content truncation limits -- see README "No fixed line-limit" section.
MAX_SYMBOLS_PER_CONTEXT_BATCH=40
MAX_AGENT_TOOL_ITERATIONS=20

# --- Verification / test execution safety ---
VERIFICATION_ENABLED=true
VERIFICATION_TIMEOUT_SECONDS=60
ALLOWED_TEST_COMMANDS=pytest,python -m pytest,python -m unittest discover

# --- Logging ---
LOG_LEVEL=INFO

# --- App ---
APP_ENV=development
CORS_ORIGINS=*
